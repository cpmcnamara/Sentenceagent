# Rhythm-Aware Pattern Miner Configuration

# Firecrawl API Key (required for URL mining)
# Get yours at https://firecrawl.dev
FIRECRAWL_API_KEY=your_api_key_here

# Database path (optional, defaults to ./index/patterns.db)
DATABASE_PATH=./index/patterns.db

# Library path (optional, defaults to ./library)
LIBRARY_PATH=./library

# Debug mode (optional)
DEBUG=false
